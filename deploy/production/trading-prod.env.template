# Template de production MyTrading. Ne pas installer tel quel : chaque [À COMPLÉTER]
# doit être renseigné par le canal de secrets approuvé puis le fichier doit être en 0600 root:root.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8083
SERVER_SERVLET_CONTEXT_PATH=/trading-api

# PostgreSQL dédié, vide et validé ; ne jamais recopier trading_uat.
SPRING_DATASOURCE_URL=[À COMPLÉTER]
SPRING_DATASOURCE_USERNAME=trading
SPRING_DATASOURCE_PASSWORD=[À COMPLÉTER]

# MyPortal JWT et CORS de production uniquement.
MYPORTAL_JWT_ISSUER=[À COMPLÉTER]
MYPORTAL_JWKS_URI=[À COMPLÉTER]
TRADING_CORS_ALLOWED_ORIGINS=[À COMPLÉTER]

# StoneX / PMXConnect. TokenID via le gestionnaire de secrets, jamais dans Git ou les logs.
TRADING_PROVIDER_MODE=PMXCONNECT
PMXCONNECT_BASE_URL=[À COMPLÉTER]
PMXCONNECT_VERSION=[À CONFIRMER]
PMXCONNECT_TOKEN_ID=[À COMPLÉTER]
PMXCONNECT_ENVIRONMENT=[À CONFIRMER]
PMXCONNECT_REQUEST_TIMEOUT=[À CONFIRMER]
PMXCONNECT_TOKEN_EXPIRY_WARNING=[À CONFIRMER]
PMXCONNECT_TOKEN_EXPIRY_CHECK_INTERVAL=[À CONFIRMER]

# AS400 : valeurs techniques de production. Les STE/NUCLI trading restent dans trading_account.
TRADING_AS400_JDBC_URL=[À COMPLÉTER]
TRADING_AS400_USERNAME=[À COMPLÉTER]
TRADING_AS400_PASSWORD=[À COMPLÉTER]
TRADING_AS400_ENABLED=false
TRADING_AS400_COMMIT_MODE=[À CONFIRMER SUR LA CIBLE]
TRADING_AS400_SYNC_DELAY=[À CONFIRMER]
TRADING_AS400_SUBMITTED_POLL_DELAY=[À CONFIRMER]
TRADING_AS400_ACCEPTED_POLL_DELAY=[À CONFIRMER]
TRADING_AS400_LFMP_COMPANY=[À COMPLÉTER]
TRADING_AS400_SAAMP_COMPANY=[À COMPLÉTER]
TRADING_AS400_LFMP_SAAMP_INTERCO_NUCLI=[À COMPLÉTER]
TRADING_AS400_SAAMP_LFMP_INTERCO_NUCLI=[À COMPLÉTER]
TRADING_AS400_STONEX_EUR_NUCLI=[À COMPLÉTER]
TRADING_AS400_STONEX_USD_NUCLI=[À COMPLÉTER]

# Effective Balance : ne pas choisir le cutover ni ENFORCED dans ce template.
# Le premier boot garde l'execution gate fermé ; activation après validation UAT/AS400.
TRADING_EFFECTIVE_BALANCE_MODE=[À DÉCIDER AVANT DÉMARRAGE]
TRADING_EFFECTIVE_BALANCE_OVERLAY_CUTOVER_AT=[À FIXER UNE SEULE FOIS]
TRADING_EFFECTIVE_BALANCE_MAX_SNAPSHOT_AGE=[À CONFIRMER APRÈS MESURE]

# Défense démo : doit rester faux en production.
# Opt-in possible apres provisioning de comptes DEMO dedies ; execution toujours SIMULATED.
TRADING_DEMO_ENABLED=false
TRADING_EXECUTION_GATE_CLOSE_ON_STARTUP=true

# Réconciliation et worker restent désactivés au premier boot jusqu'au GO métier séparé.
TRADING_RECONCILIATION_ENABLED=false

# Risk Monitor et SMTP : compléter seulement si son activation est approuvée.
TRADING_RISK_MONITOR_ENABLED=false
TRADING_RISK_MONITOR_INTERVAL=[À COMPLÉTER]
TRADING_RISK_MONITOR_MAX_PRICE_AGE=[À COMPLÉTER]
TRADING_RISK_MONITOR_HYSTERESIS_POINTS=[À COMPLÉTER]
TRADING_RISK_MONITOR_REARM_DURATION=[À COMPLÉTER]
TRADING_RISK_MONITOR_MAX_OBSERVATION_GAP=[À COMPLÉTER]
TRADING_RISK_MONITOR_BATCH_SIZE=[À COMPLÉTER]
TRADING_RISK_MONITOR_CLAIM_LEASE=[À COMPLÉTER]
TRADING_RISK_MONITOR_RETRY_INITIAL=[À COMPLÉTER]
TRADING_RISK_MONITOR_RETRY_MAX=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_HOST=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_PORT=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_USERNAME=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_PASSWORD=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_FROM=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_RECIPIENTS=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_START_TLS=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_SSL=[À COMPLÉTER]
TRADING_RISK_MONITOR_SMTP_TIMEOUT=[À COMPLÉTER]
